{
  "name": "nestjs-pg-boss",
  "version": "0.2.0",
  "description": "NestJS module for pg-boss: declarative queues, decorator-based workers and schedules, and transactional enqueueing.",
  "keywords": [
    "nestjs",
    "pg-boss",
    "postgres",
    "queue",
    "jobs",
    "background-jobs"
  ],
  "license": "MIT",
  "author": "AbderraHman El Haddad Asofi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4reha/nestjs-pg-boss.git"
  },
  "homepage": "https://github.com/4reha/nestjs-pg-boss#readme",
  "bugs": {
    "url": "https://github.com/4reha/nestjs-pg-boss/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build",
    "check:package": "publint && attw --pack . --profile esm-only",
    "test:postgres": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.postgres.config.cjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "pg-boss": "^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@electric-sql/pglite": "^0.5.12",
    "@jest/globals": "^30.5.2",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "pg-boss": "^12.38.0",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  }
}
