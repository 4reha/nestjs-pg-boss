{
  "name": "orders-api-example",
  "private": true,
  "version": "0.0.0",
  "description": "A NestJS app that saves an order and enqueues its confirmation job in the same transaction.",
  "scripts": {
    "db": "docker compose up -d db",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "nestjs-pg-boss": "^0.3.0",
    "pg": "^8.13.0",
    "pg-boss": "^12.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.9.0"
  }
}
